# ─────────────────────────────────────────────────────────────────
# HMR Demand Optimization API – Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# ── OpenWeatherMap ────────────────────────────────────────────────
# Get a free key at https://openweathermap.org/api
# Used for live weather_code and temperature in the XGBoost demand model
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ── Event Scraping ────────────────────────────────────────────────
# BookMyShow / Paytm Insider scraping uses public endpoints
# (no API key required for basic scraping)
# Optionally provide a Paytm Insider API key if you have one:
PAYTM_INSIDER_API_KEY=

# ── Scheduler Settings ───────────────────────────────────────────
# How often (in hours) to refresh live event data (default: 24 = once daily)
EVENT_SCRAPE_INTERVAL_HOURS=24

# How often (in hours) to refresh weather cache (default: 3)
WEATHER_REFRESH_INTERVAL_HOURS=3

# How often (in minutes) to run anomaly detection (default: 30)
ANOMALY_CHECK_INTERVAL_MINUTES=30

# ── API Settings ─────────────────────────────────────────────────
# CORS origins (comma-separated, default: * for development)
CORS_ORIGINS=*
API_HOST=0.0.0.0
API_PORT=8000
